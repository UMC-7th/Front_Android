<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 조리 난이도 스타일 설정 -->
    <style name="CustomRatingBar" parent="Widget.AppCompat.RatingBar">
        <item name="android:progressDrawable">@drawable/custom_ratingbar</item>
    </style>


    <!-- 캘린더의 날짜(Day)의 스타일 설정 -->
    <style name="CalendarViewCustom" parent="Theme.AppCompat">
        <item name="android:textColor">@drawable/selector_calendar_textcolor</item>
        <item name="font">@font/pretendard_bold</item>
    </style>

    <!-- 캘린더의 날짜(Day)의 스타일 설정 -->
    <style name="CalendarViewDateCustomText" parent="android:TextAppearance.DeviceDefault.Small">
        <item name="android:textColor">@drawable/selector_calendar_textcolor</item>
        <item name="font">@font/pretendard_medium</item>
    </style>

    <!-- 캘린더의 요일에 적용되는 스타일 -->
    <style name="CalenderViewWeekCustomText" parent="android:TextAppearance.DeviceDefault.Small">
        <item name="android:textColor">@color/Gray2</item>
        <item name="font">@font/pretendard_semibold</item>
    </style>

    <!-- 연, 월을 표시하는 헤더에 적용되는 스타일 -->
    <style name="CalendarWidgetHeader">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">#FF7300</item>
        <item name="font" >@font/pretendard_bold</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 달력 넘기는 버튼 스타일 -->
    <color name="arrow_default_color">@color/white</color>
    <color name="arrow_pressed_color">@color/Primary_Orange1</color>


    <style name="Signin">
        <item name="colorControlActivated">#FF7300</item>
        <item name="backgroundTint">@color/Primary_Orange1</item>
        <item name="android:textColor">@color/Primary_Orange1</item>
    </style>
    <style name="DialogTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>

    </style>

</resources>