<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/deliveryDateTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/22 (수) 식단 - 배송 완료"
            android:textColor="#FF5722"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <!-- 아침 메뉴 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/breakfastTitleTv"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="아침"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/breakfastMenuTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="하루 시작 포케 - 2인분"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/breakfastKcalTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="420Kcal"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/breakfastPriceTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20,000원"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- 점심 메뉴 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lunchTitleTv"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="점심"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lunchMenuTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="고등어 조림 한상 - 1인분"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/lunchKcalTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="840Kcal"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/lunchPriceTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12,000원"
                android:textSize="14sp"/>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>