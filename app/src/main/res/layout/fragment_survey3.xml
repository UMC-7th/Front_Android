<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">

    <!--  ProgressBar 추가 (가로 스크롤 Indicator) -->
    <ProgressBar
        android:id="@+id/scrollIndicator"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="280dp"
        android:layout_height="4dp"
        android:progressDrawable="@drawable/custom_scroll_indicator"
        android:max="100"
        android:progress="0"
        android:layout_marginTop="@dimen/spacing_64"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <TextView
        android:id="@+id/textView50"
        android:layout_width="wrap_content"
        android:fontFamily="@font/pretendard_bold"
        android:textSize="20sp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_32"
        android:text="알레르기가 있다면 말씀해주세요!"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scrollIndicator" />

    <TextView
        android:id="@+id/textView51"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/Gray6"
        android:layout_marginTop="@dimen/spacing_8"
        android:fontFamily="@font/pretendard_medium"
        android:text="안전한 식단 추천에 중요해요"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView50" />


    <LinearLayout
        android:layout_marginTop="@dimen/spacing_64"
        android:orientation="vertical"
        android:id="@+id/linear_survey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView51">


        <com.google.android.material.button.MaterialButton
            android:id="@+id/suv_1"
            android:layout_gravity="center"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/Gray8"
            android:text="있음"
            android:textColor="@color/Gray4"
            android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/suv_2"
            android:layout_gravity="center"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/Gray8"
            android:text="없음"
            android:textColor="@color/Gray4"
            android:textStyle="bold" />






    </LinearLayout>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/prev_1"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="54dp"
        android:layout_marginTop="84dp"
        android:backgroundTint="@color/Gray8"
        android:text="이전"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linear_survey" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/next_1"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4sp"
        android:layout_gravity="center"
        android:layout_marginTop="84dp"
        android:backgroundTint="@color/Gray7"
        android:text="다음"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/prev_1"
        app:layout_constraintTop_toBottomOf="@+id/linear_survey" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="152dp"
        android:layout_marginEnd="4dp"
        android:rotation="60"
        android:src="@drawable/background_ic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linear_survey" />


</androidx.constraintlayout.widget.ConstraintLayout>