<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UMC"
        tools:targetApi="31">
        <activity
            android:name=".Splash.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Signin.LoginActivity"
            android:exported="true">
        </activity>
        <activity android:name=".Onboarding.OnboardingMain"
            android:exported="true"></activity>
        <activity
            android:name=".Main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
<!--        &lt;!&ndash; DietActivity 등록 &ndash;&gt;-->
        <!-- activity로 만드셔서 전부 등록했습니다-->
        <activity android:name=".Onboarding.DietActivity" />
        <activity android:name=".Onboarding.MyActivity" />
        <activity android:name=".Onboarding.PriceActivity" />
        <activity android:name=".Onboarding.SubscribeActivity" />
    </application>

</manifest>